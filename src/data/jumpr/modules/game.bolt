from bolt_expressions import Scoreboard, Data
from libs.text_components import translated, score
from enum import Enum

Scoreboard.add_objective("game_data")
Scoreboard.add_objective("points")
Scoreboard.add_objective("round_deaths", "deathCount")
Scoreboard.add_objective("temp")

data = Scoreboard.objective("game_data")
points = Scoreboard.objective("points")
round_deaths = Scoreboard.objective("round_deaths")
temp = Scoreboard.objective("temp")

timer = Scoreboard.objective("timer")
settings = Scoreboard.objective("game_settings")

phase = data["$phase"]

IDLE = 0
COUNTDOWN = 1
RUN = 2
FINISH = 3
BUILD = 4

function jumpr:game/start_next_phase:
    phase += 1
    if phase > BUILD:
        phase = COUNTDOWN
    
    def countdown():
        timer["$ticks"] = 20 * 5
        function jumpr:timer/start

    title @a times 0.1s 2s 0.5s

    if phase == COUNTDOWN:
        countdown()
        tp @a @n[tag=level.start]
        as @e[tag=level.start] at @s:
            fill ~10 ~5 ~2 ~-10 ~-5 ~2 barrier replace air

    if phase == RUN:
        title @a title translated("jumpr.game.phase.run.start", "Run!", formatting={"color": "green"})
        function jumpr:timer/set/from_settings
        function jumpr:timer/start
        tag @a remove finished
        round_deaths["@a"].reset()
        as @e[type=item]:
            Data.entity("@s").PickupDelay = 0
        
        as @e[tag=level.start] at @s:
            fill ~10 ~5 ~2 ~-10 ~-5 ~2 air replace barrier
    
    if phase == FINISH:
        title @a actionbar ""
        title @a title translated("jumpr.game.phase.run.end", "Round over!", formatting={"color": "green"})
        tellraw @a[tag=!finished] translated("jumpr.game.phase.run.end.not_finished", "You didn't finish this round!", formatting={"color":"red"})
        countdown()

    if phase == BUILD:
        tag @a remove done
        title @a title translated("jumpr.game.phase.build.start", "Build Phase", formatting={"color": "yellow"})
        tellraw @a translated("jumpr.game.phase.build.description", 
            "Build obstacles using the items given to you to stop the other players from reaching the end.",
            formatting={"color": "gray"})
        
        temp["$items_to_give"] = settings["$build_items"]
        function jumpr:game/build_phase/give_items

function jumpr:game/build_phase/give_items:
    def give_items(selector: str):
        loot give @a loot jumpr:item/any
    
    if settings["$share_items"] == 1:
        give_items("@a")
    else:
        as @a:
            give_items("@s")

    temp["$items_to_give"] -= 1
    if temp["$items_to_give"] > 0:
        function jumpr:game/build_phase/give_items

function jumpr:game/tick:
    def lock_items():
        as @e[type=minecraft:item]:
            if entity @s[nbt={Item:{components:{"minecraft:custom_data": {"coin": 1b}}}}]:
                Data.entity("@s").PickupDelay = 200
            
            unless entity @s[nbt={Item:{components:{"minecraft:custom_data": {"coin": 1b}}}}]:
                Data.entity("@s").PickupDelay = 0
                at @s:
                    tp @s @p

    if phase == COUNTDOWN:
        title @a times 0s 2s 0s
        for i in range(1, 6):
            if timer["$ticks"] == i * 20:
                color = "yellow"
                if i <= 3:
                    color = "red"
                
                title @a title {
                    "text": f"{i}",
                    "color": color
                }

                pitch = 2.0 - (i * 0.1)
                as @a at @s anchored eyes:
                    playsound minecraft:ui.button.click master @s ~ ~ ~ 0.5 pitch
        
        if temp["$particle_cooldown"] <= 0:
            temp["$particle_cooldown"] = 10
            as @e[tag=level.start] at @s:
                for x in range(-5, 5):
                    x *= 0.7
                    for y in range(-2, 5):
                        y *= 0.7
                        entity = Data.entity("@s")
                        particle minecraft:dust{color:[1.0, 0.2, 0.2], duration:50.0, scale:1.0} ~x ~y ~1.5 0 0 0 0 5 normal
        else:
            temp["$particle_cooldown"] -= 1
                

    if phase == RUN:
        function jumpr:timer/display
        as @a[tag=!finished] at @s if block ~ ~-1 ~ minecraft:lodestone:
            function jumpr:game/player_finish
        unless entity @a[tag=!finished]:
            function jumpr:game/start_next_phase
    
    if phase == FINISH:
        lock_items()

    if phase == BUILD:
        lock_items()
        
        unless entity @a[nbt={Inventory:[{components:{"minecraft:custom_data":{"keep_through_phase": 0b}}}]}]:
            if temp["$checked_for_items"] == 1:
                function jumpr:game/start_next_phase
                temp["$checked_for_items"].reset()
            else:
                temp["$checked_for_items"] = 1
        if entity @a[nbt={Inventory:[{components:{"minecraft:custom_data":{"keep_through_phase": 0b}}}]}]:
            temp["$checked_for_items"].reset()
        as @a[nbt=!{Inventory:[{components:{"minecraft:custom_data":{"keep_through_phase": 0b}}}]}, tag=!done]:
            tag @s add done
            tellraw @s translated("jumpr.game.build_phase.done", "%s is done!", [{"selector": "@s"}], {"color": "green"})

        

function jumpr:game/player_finish:
    def msg(formatted_timer: str):
        tellraw @a translated("jumpr.game.player_finish", "%s finished with %s left!", 
            [{"selector": "@s", "color": "white"}, formatted_timer], 
            {"color": "green"})
    
    def add_points(count: int, reason: str, formatted_reason: str):
        points["@s"] += count
        tellraw @a [
            {
                "text": f"     +{count}p → ",
                "color": "gray"
            },
            translated(f"jumpr.game.player_finish.points.{reason}", formatted_reason)
        ]

    formatted_timer = [
        {"text": "", "color": "white"},
        score("$min", "timer"),
        ":",
        score("$sec", "timer"),
        ".",
        score("$ds", "timer")
    ]
    if timer["$sec"] > 9:
        msg(formatted_timer)
    else:
        formatted_timer.insert(2, "0")
        msg(formatted_timer)

    add_points(1, "finished", "Finished")

    unless entity @a[tag=finished]:
        add_points(2, "first", "Finished 1st")
    
    if not round_deaths["@s"] > 0:
        add_points(5, "no_deaths", "No deaths")
    
    if entity @s[nbt={Inventory: [{components: {"minecraft:custom_data":{"coin": 1b}}}]}]:
        clear @s *[minecraft:custom_data~{"coin": 1b}] 1
        add_points(5, "coin", "Coin")

    tag @s add finished