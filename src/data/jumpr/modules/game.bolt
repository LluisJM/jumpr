from bolt_expressions import Scoreboard, Data, ScoreSource
from libs.text_components import translated, score
from enum import Enum

Scoreboard.add_objective("game_data")
Scoreboard.add_objective("points")
Scoreboard.add_objective("round_deaths", "deathCount")
Scoreboard.add_objective("temp")

data = Scoreboard.objective("game_data")
points = Scoreboard.objective("points")
round_deaths = Scoreboard.objective("round_deaths")
temp = Scoreboard.objective("temp")

timer = Scoreboard.objective("timer")
settings = Scoreboard.objective("game_settings")

phase = data["$phase"]
round = data["$round"]

IDLE = 0
COUNTDOWN = 1
RUN = 2
FINISH = 3
BUILD = 4

def set_ai(entity: str, value: bool):
    as @e[type=f"{entity}"]:
        Data.entity("@s").NoAI = not value
        Data.entity("@s").Invulnerable = not value

function jumpr:game/load:
    def create_team(id: str, name: str, color: str, prefix: str):
        team add id name
        team modify id color color
        team modify id prefix prefix
    
    create_team("build_phase.done", "Done", "green", "✔ ")
    create_team("build_phase.not_done", "Not Done", "red", "❌ ")

function jumpr:game/start:
    function jumpr:game/end
    function jumpr:level/reload
    round = 0
    phase = IDLE
    function jumpr:game/start_next_phase

function jumpr:game/end:
    function jumpr:timer/stop
    phase = IDLE
    gamemode adventure @a

function jumpr:game/start_next_phase:
    phase += 1
    if phase == BUILD:
        if round >= settings["$max_rounds"]:
            function jumpr:game/end
    if phase > BUILD:
        round += 1
        phase = COUNTDOWN
    
    def countdown(sec: int):
        timer["$ticks"] = 20 * sec
        function jumpr:timer/start
    
    def barrier(place: bool = True):
        half_width = 10
        half_height = 5
        z = 2

        x1 = f"~{half_width}"
        y1 = f"~{half_height}"
        z1 = f"~{z}"

        x2 = f"~{-half_width}"
        y2 = f"~{-half_height}"
        z2 = f"~{z}"

        block = "air"#  else "air"
        replace = "barrier"# if place else "barrier"

        if place:
            block = "barrier"
            replace = "air"

        as @e[tag=level.start] at @s:
            fill x1 y1 z1 x2 y2 z2 block replace replace

    title @a times 0.1s 2s 0.5s

    if phase == COUNTDOWN:
        title @a title translated("jumpr.game.phase.round", "Round %s", [round.component()], formatting={"color": "green"})

        team empty build_phase.done
        team empty build_phase.not_done
        gamemode adventure @a
        countdown(10)
        tp @a @n[tag=level.start]
        barrier(True)

    if phase == RUN:
        set_ai("creeper", True)
        set_ai("shulker", True)
        title @a title translated("jumpr.game.phase.run.start", "Run!", formatting={"color": "green"})
        function jumpr:timer/set/from_settings
        function jumpr:timer/start
        tag @a remove finished
        round_deaths["@a"].reset()
        as @e[type=item]:
            Data.entity("@s").PickupDelay = 0
        
        barrier(False)
    
    if phase == FINISH:
        kill @e[type=shulker_bullet]
        set_ai("creeper", False)
        set_ai("shulker", False)
        title @a actionbar ""
        title @a title translated("jumpr.game.phase.run.end", "Round over!", formatting={"color": "green"})
        tellraw @a[tag=!finished] translated("jumpr.game.phase.run.end.not_finished", "You didn't finish this round!", formatting={"color":"red"})
        countdown(5)

    if phase == BUILD:
        team join build_phase.not_done @a
        gamemode survival @a
        attribute @s minecraft:block_break_speed base set 0
        tag @a remove done
        title @a title translated("jumpr.game.phase.build.start", "Build Phase", formatting={"color": "yellow"})
        tellraw @a translated("jumpr.game.phase.build.description", 
            "Build obstacles using the items given to you to stop the other players from reaching the end.",
            formatting={"color": "gray"})
        
        temp["$items_to_give"] = settings["$build_items"]
        function jumpr:game/build_phase/give_items

function jumpr:game/build_phase/give_items:
    def give_items(selector: str):
        loot give @a loot jumpr:item/any
    
    if settings["$share_items"] == 1:
        give_items("@a")
    else:
        as @a:
            give_items("@s")

    temp["$items_to_give"] -= 1
    if temp["$items_to_give"] > 0:
        function jumpr:game/build_phase/give_items

function jumpr:game/tick:
    def lock_items():
        as @e[type=minecraft:item]:
            if entity @s[nbt={Item:{components:{"minecraft:custom_data": {"coin": 1b}}}}]:
                Data.entity("@s").PickupDelay = 200
            
            unless entity @s[nbt={Item:{components:{"minecraft:custom_data": {"coin": 1b}}}}]:
                Data.entity("@s").PickupDelay = 0
                at @s:
                    tp @s @p

    if phase == COUNTDOWN:
        function jumpr:timer/display

        title @a times 0s 2s 0s
        for i in range(1, 6):
            if timer["$ticks"] == i * 20:
                color = "yellow"
                if i <= 3:
                    color = "red"
                
                title @a title {
                    "text": f"{i}",
                    "color": color
                }

                pitch = 2.0 - (i * 0.1)
                as @a at @s anchored eyes:
                    playsound minecraft:ui.button.click master @s ~ ~ ~ 0.5 pitch
        
        as @e[type=marker, tag=level.start]:
            level_start = Data.entity("@s")
            temp["$level_start_z"] = level_start.Pos[2]
            as @a at @s:
                player = Data.entity("@s")
                temp["@s"] = player.Pos[2]
                if temp["@s"] > temp["$level_start_z"] + 1:
                    z_sub = 5.612 / 20
                    tp @s ~ ~0 ~-z_sub

        if temp["$particle_cooldown"] <= 0:
            temp["$particle_cooldown"] = 10
            as @e[tag=level.start] at @s:
                for x in range(-5, 5):
                    x *= 0.7
                    for y in range(-2, 5):
                        y *= 0.7
                        entity = Data.entity("@s")
                        particle minecraft:dust{color:[1.0, 0.2, 0.2], duration:50.0, scale:1.0} ~x ~y ~1.5 0 0 0 0 5 normal
        else:
            temp["$particle_cooldown"] -= 1
    
    if phase == RUN:
        function jumpr:timer/display
        as @a[tag=!finished] at @s if block ~ ~-1 ~ minecraft:lodestone:
            function jumpr:game/player_finish
        unless entity @a[tag=!finished]:
            function jumpr:game/start_next_phase
    
    if phase == FINISH:
        lock_items()

    if phase == BUILD:
        set_ai("creeper", False)
        set_ai("shulker", False)
        lock_items()
        clear @a minecraft:bucket

        as @a[tag=!done]:
            if entity @s[nbt=!{Inventory:[{components:{"minecraft:custom_data":{"keep_through_phase": 0b}}}]}]:
                if entity @s[tag=ensured_items]:
                    tag @s add done
                    team join build_phase.done @s
                    tellraw @s translated("jumpr.game.build_phase.done", "%s is done!", [{"selector": "@s"}], {"color": "green"})
                tag @s add ensured_items
            if entity @s[nbt={Inventory:[{components:{"minecraft:custom_data":{"keep_through_phase": 0b}}}]}]:
                tag @s remove ensured_items
        
        unless entity @a[nbt={Inventory:[{components:{"minecraft:custom_data":{"keep_through_phase": 0b}}}]}]:
            if temp["$checked_for_items"] == 20:
                function jumpr:game/start_next_phase
                temp["$checked_for_items"].reset()
            else:
                temp["$checked_for_items"] += 1
        if entity @a[nbt={Inventory:[{components:{"minecraft:custom_data":{"keep_through_phase": 0b}}}]}]:
            temp["$checked_for_items"].reset()
        
        title @a actionbar {"selector": "@a", "separator": " - "}

function jumpr:game/player_finish:
    def msg(formatted_timer: str):
        tellraw @a translated("jumpr.game.player_finish", "%s finished with %s left!", 
            [{"selector": "@s", "color": "white"}, formatted_timer], 
            {"color": "green"})
    
    def add_points(count: int | ScoreSource, reason: str, formatted_reason: str, multiplier: int | ScoreSource = None):
        points["@s"] += count
        count_str = count.__str__()
        if isinstance(count, ScoreSource):
            count_str = count.component()

        text = [
            {
                "text": f"     +",
                "color": "gray"
            },
            count_str,
            "p → ",
            translated(f"jumpr.game.player_finish.points.{reason}", formatted_reason)
        ]

        if not multiplier:
            tellraw @a text
        else:
            if isinstance(count, ScoreSource):
                text += [" x", multiplier.component()]
            else:
                text.append(f" x{count}")
            tellraw @a text

    formatted_timer = [
        {"text": "", "color": "white"},
        score("$min", "timer"),
        ":",
        score("$sec", "timer"),
        ".",
        score("$ds", "timer")
    ]
    if timer["$sec"] > 9:
        msg(formatted_timer)
    else:
        formatted_timer.insert(2, "0")
        msg(formatted_timer)

    add_points(1, "finished", "Finished")

    unless entity @a[tag=finished]:
        add_points(2, "first", "Finished 1st")
    
    if not round_deaths["@s"] > 0:
        add_points(5, "no_deaths", "No deaths")
    
    temp["@s"].reset()
    function jumpr:game/player_finish/count_coins

    tag @s add finished

function jumpr:game/player_finish/count_coins:
    if entity @s[nbt={Inventory: [{components: {"minecraft:custom_data":{"coin": 1b}}}]}]:
        clear @s *[minecraft:custom_data~{"coin": 1b}] 1
        temp["@s"] += 1
        unless entity @s[nbt={Inventory: [{components: {"minecraft:custom_data":{"coin": 1b}}}]}]:
            add_points(temp["@s"] * 5, "coin", "Coin", temp["@s"])
            temp["@s"].reset()
        function jumpr:game/player_finish/count_coins