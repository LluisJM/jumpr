from bolt_expressions import Scoreboard, ScoreSource
from libs.text_components import score

Scoreboard.add_objective("timer")

timer = Scoreboard.objective("timer")
settings = Scoreboard.objective("game_settings")

ticks = timer["$ticks"]
min = timer["$min"]
sec = timer["$sec"]
ds = timer["$ds"]

running = timer["$running"]

def set(ticks: ScoreSource, _sec: int, _min: int = 0):
    ticks = (_min * 20 * 60) + (_sec * 20)

def start(_sec: int, _min: int = 0):
    timer["$running"] = 1
    set(timer["$ticks"], _sec, _min)

def format(ticks: ScoreSource, min: ScoreSource, sec: ScoreSource, ds: ScoreSource):
    min = (ticks - (ticks % (20*60))) / (20*60)
    sec = (ticks - (ticks % 20) - (min*20*60)) / 20
    ds = (ticks - (ticks % 2) - (min*20*60) - (sec*20)) / 2

function jumpr:timer/set/from_settings:
    ticks = settings["$round_length"]

function jumpr:timer/start:
    running = 1

function jumpr:timer/stop:
    as @a at @s anchored eyes:
        playsound minecraft:ui.button.click master @s ~ ~ ~ 0.5 1.8
    running = 0

    function jumpr:game/start_next_phase

function jumpr:timer/reset:
    ticks = 0

function jumpr:timer/tick:
    format(ticks, min, sec, ds)

    if running == 1:
        if ticks <= 0:
            function jumpr:timer/stop
        else:
            ticks -= 1

function jumpr:timer/display:
    text = [
        score("$min", "timer"),
        ":",
        score("$sec", "timer"),
        ".",
        score("$ds", "timer")
    ]
    if sec > 9:
        title @a actionbar text
    else:
        text.insert(2, "0")
        title @a actionbar text